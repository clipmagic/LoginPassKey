namespace ProcessWire;

class ProcessLoginPassKey extends ProcessModule
{

    public $limit = 50;

    public function __construct()
    {
        parent::__construct(); // remember to call the parent
    }

    public function init()
    {
        parent::init(); // always remember to call the parent init
        $lpk = $this->wire('modules')->get('LoginPassKey');
    }

    public function ___execute()
    {
        $modules = $this->wire()->modules;
        $input = $this->wire('input');
        $search = $this->getSearchQuery();
        if ($search !== '') {
            $input->whitelist('q', $search);
        }

        $form = $modules->get('InputfieldForm');

        /** @var MarkupAdminDataTable $table */
        $table = $modules->get('MarkupAdminDataTable');
        $table->setEncodeEntities(false);
        $table->headerRow([
            $this->_x('Id', 'th'),
            $this->_x('User Id', 'th'),
            $this->_x('Username', 'th'),
            $this->_x('Created', 'th'),
            wireIconMarkup('trash', 'lg')
        ]);

        /** @var InputfieldCheckbox $checkbox */
        $checkbox = $modules->get('InputfieldCheckbox');
        $checkbox->attr('name', 'deletes[]');
        $checkbox->addClass('delete-checkbox');
        $checkbox->checkboxOnly = true;
        $checkbox->label = ' ';

        /** @var InputfieldMarkup */
        $f = $modules->get('InputfieldMarkup');
        $markup = "<h3>";
        $markup .= $this->_("Please note:");
        $markup .= "</h3>";
        $markup .= "<p>";
        $markup .= $this->_("Deleting passkeys from the database will NOT delete them from the device(s).");
        $markup .= "</p>";
        $f->set('value', $markup);

        $pagination = $this->renderPagination($search);

        $form->set('value', $f->value . $this->getPassKeys($table, $checkbox, $search) . $pagination);

        /** @var InputfieldButton $f */
        $f = $modules->get('InputfieldSubmit');
        $f->attr('name', 'submit_delete_checked');
        $f->value = $this->_('Delete checked');
        $f->addClass('btn-delete-checked');
        $f->icon = 'trash';
        $f->showInHeader(true);
        $form->add($f);

        if ($input->post('submit_delete_checked') && is_array($input->post('deletes'))) {
            $count = $this->deletePassKeys($form);
            if ($count > 0) {
                $this->message(sprintf(_n('%d PassKey deleted from database.', '%d PassKeys deleted from database.', $count), $count));
                $this->session->redirect($this->wire()->page->url);
            }
        }
        return $this->renderSearchForm($search) . $form->render();
    }

    protected function getSearchQuery(): string
    {
        return trim((string) $this->wire('sanitizer')->text($this->wire('input')->get('q')));
    }

    protected function renderSearchForm(string $search): string
    {
        $sanitizer = $this->wire('sanitizer');
        $action = $sanitizer->entities($this->wire('page')->url);
        $value = $sanitizer->entities($search);
        $label = $this->_('Search passkeys');
        $placeholder = $this->_('User ID, passkey ID, username, or created date');
        $submit = $this->_('Search');
        $reset = $this->_('Reset');
        $resetUrl = $sanitizer->entities($this->wire('page')->url);

        return <<<HTML
<form method="get" action="$action" class="InputfieldForm LoginPassKeySearchForm">
    <label for="lpk_passkey_search">$label</label>
    <input type="search" id="lpk_passkey_search" name="q" value="$value" placeholder="$placeholder">
    <button type="submit" class="ui-button ui-widget ui-corner-all">$submit</button>
    <a href="$resetUrl" class="ui-button ui-widget ui-corner-all">$reset</a>
</form>
HTML;
    }

    public function renderPagination(string $search = '')
    {
        $input = $this->wire('input');
        $start = ($input->pageNum - 1) * $this->limit;
        $total = (int)$this->countCredentialsInDb($search);

        $a = new PageArray();
        $a->setDuplicateChecking(false);
        $listed = max(0, min($this->limit, $total - $start));
        for ($n = 0; $n < $listed; $n++) $a->add(new Page());

        $a->setTotal($total);
        $a->setLimit($this->limit);
        $a->setStart($start);

        return $a->renderPager();
    }

    public function getAllCredentialsFromDB(string $search = '')
    {
        $lpk = $this->wire('modules')->get('LoginPassKey');
        $input = $this->wire('input');
        $offset = $this->limit * ($input->pageNum - 1);

        try {
            $db = wire('database');
            [$where, $params] = $this->getSearchSql($search);
            $sql = "SELECT lpk.`id`, lpk.`user_id`, COALESCE(p.`name`, '') AS `username`, lpk.`created` " .
                "FROM " . $lpk->getTableName() . " lpk " .
                "LEFT JOIN `pages` p ON p.`id`=lpk.`user_id` " .
                $where .
                " ORDER BY lpk.`created` DESC, lpk.`id` DESC LIMIT :limit OFFSET :offset";
            $query = $db->prepare($sql);
            foreach ($params as $name => $value) {
                $query->bindValue($name, $value, is_int($value) ? \PDO::PARAM_INT : \PDO::PARAM_STR);
            }
            $query->bindValue(':limit', (int) $this->limit, \PDO::PARAM_INT);
            $query->bindValue(':offset', (int) $offset, \PDO::PARAM_INT);
            $query->closeCursor();
            $query->execute();
            $result = $query->fetchAll(\PDO::FETCH_OBJ);
            return $result;
        } catch (\Throwable $e) {
            $this->wire('log')->save($this->className(), "Database Exception: " . $e->getMessage());
            return [];
        }
    }

    public function countCredentialsInDb(string $search = '')
    {
        $lpk = $this->wire('modules')->get('LoginPassKey');
        $db = wire('database');
        try {
            [$where, $params] = $this->getSearchSql($search);
            $sql = "SELECT COUNT(lpk.`id`) FROM " . $lpk->getTableName() . " lpk " .
                "LEFT JOIN `pages` p ON p.`id`=lpk.`user_id` " .
                $where;
            $query = $db->prepare($sql);
            foreach ($params as $name => $value) {
                $query->bindValue($name, $value, is_int($value) ? \PDO::PARAM_INT : \PDO::PARAM_STR);
            }
            $query->closeCursor();
            $query->execute();
            return $query->fetchColumn();
        } catch (\Throwable $e) {
            $this->wire('log')->save($this->className(), "Database Exception: " . $e->getMessage());
            return 0;
        }
    }

    protected function getSearchSql(string $search): array
    {
        if ($search === '') {
            return ['', []];
        }

        $where = " WHERE p.`name` LIKE :search_like OR lpk.`created` LIKE :search_like";
        $params = [':search_like' => '%' . $search . '%'];

        if (ctype_digit($search)) {
            $where .= " OR lpk.`id`=:search_id OR lpk.`user_id`=:search_id";
            $params[':search_id'] = (int) $search;
        }

        return [$where, $params];
    }

    public function ___deletePassKeys($form)
    {
        $input = $this->wire('input');
        $lpk = $this->wire('modules')->get('LoginPassKey');
        $db = $this->wire('database');

        // process deleted passkeys
        $form->processInput($input->post); // for CSRF only
        $ids = \array_values(\array_filter(\array_map('intval', (array) $input->post('deletes'))));
        if (\count($ids) === 0) return 0;

        $placeholders = \implode(',', \array_fill(0, \count($ids), '?'));
        $sql = "DELETE FROM " . $lpk->getTableName() . " WHERE id IN ($placeholders)";
        $query = $db->prepare($sql);
        $query->closeCursor();

        try {
            $query->execute($ids);
        } catch (WireException $e) {
            throw new WireException("An error occurred while trying to delete: " . $e->getMessage());
        }
        return $query->rowCount();
    }

    public function ___getPassKeys($table, $checkbox, string $search = '')
    {
        $sanitizer = $this->wire('sanitizer');

        $passkeys = $this->getAllCredentialsFromDB($search);

        if (\count($passkeys) === 0) {
            $table->row(['', '', $this->_("There are no matching passkeys."), '', '']);
        }
        foreach ($passkeys as $passkey => $v) {
            $checkbox->attr('id', "delete_" . $sanitizer->int($v->id));
            $checkbox->attr('value', $v->id);

            $userName = $v->username !== '' ? $v->username : $this->_('Unknown user');
            $table->row([$v->id, $v->user_id, $userName, $v->created, $checkbox->render(),]);
        }
        return $table->render();
    }

    public function ___install()
    {
        parent::___install(); // Process modules must call parent method
    }

    public function ___uninstall()
    {
        parent::___uninstall(); // Process modules must call parent method
    }
}

class LoginPassKey extends WireData implements Module, ConfigurableModule
{
    public $transports = ['hybrid', 'internal'];

//    public $attestationFormat = 'none';
    public $attestationFormat = 'none';

    public $userVerification = 'required';

    public $residentKey = 'preferred';

    public $userDisplayName = null;

    public $crossPlatformAttachment = null;

    protected const REGISTER_CSRF_ID = 'loginpasskey-register';

    public function getModuleConfigInputfields(array $data)
    {
        $modules = wire('modules');
        $sanitizer = wire('sanitizer');

        $fields = new InputfieldWrapper();

        // field for additional info/help text

        $field = $modules->get('InputfieldMarkup');
        $field->name = 'header_text';
        $field->columnWidth = 100;
        $field->markupText = $this->_("After saving, if your User template(s) contain email fields, you'll be given the opportunity to select one. The user can then login with either their username or the selected email field address. Email addresses MUST be unique.");
        $fields->add($field);


        // Authentication options
        $fieldset = $modules->get('InputfieldFieldset');
        $fieldset->attr('name+id', 'activate');
        $fieldset->label = $this->_('Activate module');

        // Enable module load in Frontend
        $field = $modules->get('InputfieldCheckbox');
        $field->name = 'enabled';
        $field->value = null;
        $field->columnWidth	= 50;
        $field->label = $this->_("Enable Frontend Passkey login");
        if (isset($data['enabled']) && $data['enabled'] !== '') {
            $field->value = $data['enabled'];
            $field->attr('checked', 'checked');
        }
        $fieldset->add($field);
        // Enable Passkey login to Admin
        $field = $modules->get('InputfieldCheckbox');
        $field->name = 'enabledAdmin';
        $field->value = null;
        $field->columnWidth	= 50;
        $field->label = $this->_("Enable Admin Passkey login");
        if (isset($data['enabledAdmin']) && $data['enabledAdmin'] !== '') {
            $field->value = $data['enabledAdmin'];
            $field->attr('checked', 'checked');
        }
        $fieldset->add($field);
        // Enable passkey-only login with discoverable credentials
        $field = $modules->get('InputfieldCheckbox');
        $field->name = 'enabledDiscover';
        $field->value = null;
        $field->columnWidth	= 50;
        $field->label = $this->_("Enable passkey-only login");
        $field->notes = $this->_("When enabled, new passkey registrations request discoverable credentials. Existing username/email + passkey logins continue to work.");
        if (isset($data['enabledDiscover']) && $data['enabledDiscover'] !== '') {
            $field->value = $data['enabledDiscover'];
            $field->attr('checked', 'checked');
        }
        $fieldset->add($field);


        $fields->add($fieldset);

        // Authentication options
        $fieldset = $modules->get('InputfieldFieldset');
        $fieldset->attr('name+id', 'authoptions');
        $fieldset->label = $this->_('Authentication options');

        // Application name
        $field = $modules->get('InputfieldText');
        $field->name = 'appname';
        $field->label = $this->_("Application name");
        $field->columnWidth	= 50;
        $field->notes($this->_("Friendly application name")); ;
        if(!empty($data['appname']))  $field->attr('value', $this->wire()->sanitizer->text($data['appname']));
        $fieldset->add($field);

        // Replying party host
        $field = $modules->get('InputfieldText');
        $field->name = 'rp';
        $field->label = $this->_("Host name");
        $field->columnWidth	= 50;
        $field->notes($this->_("Leave blank to default to config->host")) ;
        $field->value = !empty($data['rp']) ? $sanitizer->text($data['rp']) : $this->wire('config')->httpHost;
        $fieldset->add($field);

        // User verification
        $field = $modules->get('InputfieldRadios');
        $field->name = 'userVerification';
        $field->label = $this->_("User verification");
        $field->columnWidth	= 50;
        $field->notes = $this->_("Required is recommended. Lower settings may allow passkey use without biometric/PIN verification on some authenticators.");
        $field->addOption('required', $this->_('Required'));
        $field->addOption('preferred', $this->_('Preferred'));
        $field->addOption('discouraged', $this->_('Discouraged'));
        $field->value = !empty($data['userVerification']) ? $sanitizer->option($data['userVerification'], ['required', 'preferred', 'discouraged']) : $this->userVerification;
        $fieldset->add($field);

        $fields->add($fieldset);

        // ProcessWire User settings
        $fieldset = $modules->get('InputfieldFieldset');
        $fieldset->attr('name+id', 'pwuserinfo');
        $fieldset->label = $this->_('ProcessWire User Info');

        // PW User template
        $field = $modules->get('InputfieldRadios');
        $field->name = 'user_template';
        $field->label = $this->_("User template");
        $field->columnWidth	= 33;
        $field->required = 1;
        $config = $this->wire('config');
        $tpls = wire('templates');
        foreach ($config->userTemplateIDs as $templateID) {
            $tpl = $tpls->get($templateID);
            $attrs = $tpl->id === $config->userTemplateID ? ["checked" => "checked"] : []; // default User template id
            $field->addOption($templateID, $tpl->get("label|name"), $attrs);
        }
        if (!empty($data['user_template'])) $field->attr('value', $data['user_template']);
        $fieldset->add($field);

        // ProcessWire email field from selected template
        $field = $modules->get('InputfieldRadios');
        $field->name = 'user_fld';
        $field->label = $this->_("Identify User by username or email field");
        $field->columnWidth	= 33;
        $field->notes = $this->_("After saving, a list of eligible email fields will appear");

        $field->required = 1;
        $field->addOption('name', 'Username', ['selected' => 'selected']);
        if(!empty($data['user_template'])) {
            $tpl = $tpls->get($data['user_template']);
            foreach ($tpl->fieldgroup->fields->findByType("FieldtypeEmail") as $tplField) {
                $field->addOption($tplField->name, $tplField->get("label|name"));
            }
        }
        if (!empty($data['user_fld'])) $field->attr('value', $data['user_fld']);
        $fieldset->add($field);

        // Allowed roles
        $field = $modules->get('InputfieldCheckboxes');
        $field->name = 'roles';
        $field->label = $this->_("User roles permitted to use WebAuthn");
        $field->required = 1;
        $field->columnWidth	= 34;
        $roles = $this->wire('roles')->find('limit=200');
        $config = $this->wire('config');
        if ($roles->count > 0) {
            foreach ($roles as $role) {
                if($role->id === $config->guestUserRolePageID) continue;
                $field->addOption($role->id, $role->name);
            }
        }
        if (!empty($data['roles'])) $field->attr('value', $data['roles']);
        $fieldset->add($field);

        // API endpoint
        $field = $modules->get('InputfieldText');
        $field->name = 'api_url';
        $field->columnWidth	= 50;
        $field->label = $this->_("Path to your API ENDPOINT");
        $field->value = "/lpk-api/";
        $field->notes = $this->_("Default is /lpk-api/");
        if(!empty($data['api_url']))
            $field->value = $data['api_url'];
        $field->required = 1;
        $fieldset->add($field);
        $fields->add($fieldset);

        // Redirect on login
        $field = $modules->get('InputfieldText');
        $field->name = 'redirect_url';
        $field->columnWidth	= 50;
        $field->label = $this->_("Page to redirect to on login (Frontend only)");
        $field->value = "/";
        $field->notes = $this->_("ID or path");
        if(!empty($data['redirect_url']))
            $field->value = $data['redirect_url'];

        $fieldset->add($field);
        $fields->add($fieldset);

        return $fields;
    }

    public function construct()
    {
        parent::__construct();
    }

    public function init() : void
    {
        $this->addHookAfter('Page::render', $this, 'addScriptsFE');

        $this->wire()->addHookAfter('ProcessWire::ready', function($event) {
            if(!method_exists($event->page, 'render')) {
                // module & database need to be in place before going further
                if($event->page->rootParent->name === 'module') return;

                // Remove the input->get->logout, when using
                // LoginRegisterPro to prevent it blocking subsequent passkey logins
                $user = $this->wire('user');
                $input = $this->wire('input');
                $page = $this->wire('page');
                $session = $this->wire('session');
                if(!$user->isLoggedIn() && !!$input->get->logout) {
                    $session->redirect($page->url);
                }

                if($event->page->template->name === 'admin') {
                    $config = $this->wire('config');
                    $config->styles->add($config->urls($this) . $this->className() . ".css");
                }

                if($event->page->template->name === 'admin' && $this->enabledAdmin === 1) {
                    $session = $this->wire('session');
                    $session->setFor('lpk', 'inadmin', 1);
                    $event->page->addHookBefore('render', function ($event) {
                        $config = $this->wire('config');
                        $config->scripts->add($config->urls($this) . $this->className() . ".js");
                            $config->scripts->add($config->urls($this) . $this->className() . "Admin.js");
                    });

                    $event->page->addHookAfter('ProcessLogin::buildLoginForm', $this, 'addLoginBtn');

                    $user = $this->wire('user');
                    if(empty($session->getFor('lpk', 'success')) && $user->isLoggedIn()) {
                        // show passkey registration banner if not already logged in with passkey
                        $this->wire()->addHookAfter('Page::render', $this, 'registerAdmin');
                    }
                }
            }
        });


        $this->addHook('Page::lpkFindUser', $this, 'lpkFindUser');
        $this->addHook('Page::lpkGetArgs', $this, 'lpkGetArgs');
        $this->addHook('Page::lpkPreRegisterUser', $this, 'lpkPreRegisterUser');
        $this->addHook('Page::lpkRegisterUser', $this, 'lpkRegisterUser');
        $this->addHook('Page::lpkUserHasPasskey', $this, 'lpkUserHasPasskey');
        $this->addHook('Page::lpkCanSelfManagePasskeys', $this, 'lpkCanSelfManagePasskeys');
        $this->addHook('Page::lpkGetApiUrl', $this, 'lpkGetApiUrl');
        $this->addHook('Page::lpkGetRedirectUrl', $this, 'lpkGetRedirectUrl');
        $this->addHook('Page::lpkGetApiHttpUrl', $this, 'lpkGetApiHttpUrl');
        $this->addHook('Page::lpkGetWebAuthn', $this, 'lpkGetWebAuthn');
        $this->addHook('Page::lpkVerify', $this, 'lpkVerify');
        $this->addHook('Page::lpkGetUserByField', $this, 'lpkGetUserByField');
        $this->addHook('Page::lpkVerifyResponse', $this, 'lpkVerifyResponse');
        $this->addHook('Page::lpkGetErrorMessage', $this, 'lpkGetErrorMessage');
        $this->addHookBefore('ProcessProfile::execute', $this, 'processProfilePasskeyActions');
        $this->addHookAfter('ProcessProfile::execute', $this, 'addProfilePasskeyManagement');
    }

    public function ___ready() : void
    {

    }

    #---------------------
    # Hooks
    #---------------------

    // Methods added to Page for use in templates

    public function lpkFindUser(HookEvent $event)
    {
        $user = $event->arguments(0);
        $event->return = $this->findUser($user);
    }

    public function lpkGetApiUrl(HookEvent $event)
    {
        $event->return = $this->api_url;
    }

    public function lpkGetRedirectUrl(HookEvent $event)
    {
        $event->return = $this->getRedirectUrl();
    }

    public function lpkGetApiHttpUrl(HookEvent $event)
    {
        $event->return = $this->getApiHttpUrl();
    }

    public function lpkGetArgs(HookEvent $event)
    {
        $event->return = $this->getlpkargs();
    }

    public function lpkPreRegisterUser(HookEvent $event)
    {
        $user = $event->arguments(0);
        $event->return = $this->preRegisterUser($user);
    }

    public function lpkGetUserByField(HookEvent $event)
    {
        $username = $event->arguments(0);
        $event->return = $this->getUserByField($username);
    }

    public function lpkGetErrorMessage(HookEvent $event)
    {
        $errormsg = $event->arguments(0);
        $event->return = $this->getErrorMessage($errormsg);
    }

    public function lpkRegisterUser(HookEvent $event)
    {
        $user = $event->arguments(0);
        $dn = $event->arguments(1);
        $event->return = $this->registerUser($user, $dn);
    }

    public function lpkUserHasPasskey(HookEvent $event)
    {
        $user = $event->arguments(0);
        $event->return = $user instanceof User && $this->userHasPasskey($user);
    }

    public function lpkCanSelfManagePasskeys(HookEvent $event)
    {
        $user = $event->arguments(0);
        $event->return = $this->canSelfManagePasskeys($user instanceof User ? $user : null);
    }

    public function lpkVerify(HookEvent $event)
    {
        $user = $event->arguments(0);
        $event->return = $this->verifyUser($user);
    }

    public function lpkVerifyResponse(HookEvent $event)
    {
        $credData = $event->arguments(0);
        $challenge = $event->arguments(1);
        $signedData = $event->arguments(2);
        $event->return = $this->verifyResponse($credData, $challenge, $signedData);
    }

    // lpk only hooks
    public function addScriptsFE(HookEvent $event)
    {
        $return = $event->return;
        if(!$this->enabled) return;
        if($this->page->template->name !== 'admin') {
            if(\strpos($return, $this->className() . ".css") === false) {
                $css = "<link rel='stylesheet' href='" . $this->config()->urls($this) . $this->className() . ".css'>";
                $return = str_ireplace("</head>", $css . "</head>", $return);
            }
            if(\strpos($return, $this->className() . ".js") === false) {
                $js = "<script src='" . $this->config()->urls($this) . $this->className() . ".js'></script>";
                $return = str_ireplace("</body>", $js . "</body>", $return);
            }
        }
        $event->return = $return;
    }

    public function addLoginBtn(HookEvent $event)
    {
        if($this->user->isLoggedin()) return;

        $form = $event->return;
        $modules = $this->wire('modules');

        $passKeyButton = $modules->get('InputfieldButton');
        $passKeyButton->attr('id+name', 'lpk');
        $passKeyButton->addClass('top_button');
        $passKeyButton->attr('value', $this->_("Login with PassKey"));
        $passKeyButton->icon = 'key';
        $passKeyButton->attr('href', '#');
        $form->add($passKeyButton);

        $markUp = $modules->get('InputfieldMarkup');
        $markUp->attr('id+name', 'end');

        $html = "<div id='end' class='uk-margin'></div>";
        $modules = $this->wire('modules');
//        $apiUrl = $modules->getConfig('LoginPassKey')['api_url'];

        $apiUrl = $this->getApiHttpUrl();

        $html .= "<script>let apiUrl = '$apiUrl'</script>";
//        $html .= "if(!apiUrl)";
//        $html .= "let apiUrl = '$apiUrl'</script>";
        $markUp->value = $html;
        $form->add($markUp);

        $event->return = $form;
    }

    public function registerAdmin(HookEvent $event) {

        // Offer passkey registration to an eligible logged-in admin user.
        if ($this->wire('input')->requestMethod('POST')) return;

        $user = $this->wire('user');

        $lpk = $this->wire('modules')->get('LoginPassKey');
        $apiUrl = $this->api_url;

        $allowed = $this->userAllowed($user);

        if ($allowed !== false && !$this->userHasPasskey($user)) {

            $fwd = new \stdClass();
            $fwd->fn = 'finduser';
            $fwd->un = $user->name;
            $fwd->next = 'register';

            $data = new \stdClass();
            $data->pk = $lpk->preRegisterUser($user);
            $data->csrf = $this->getRegisterCsrfToken();
            $data->next = 'register';

            $fwd->data = $data;
            $fwdJSON = \json_encode($fwd);
            $bannerId = 'LoginPassKeyRegisterBanner';
            $endId = 'LoginPassKeyRegisterResult';
            $bannerText = $this->_('Add a passkey to sign in faster next time.');
            $addText = $this->_('Add passkey');
            $dismissText = $this->_('Not now');
            $successText = $this->_('Passkey added.');

            $html = <<<HTML
<div id="$bannerId" class="LoginPassKeyBanner NoticeWarning ui-state-highlight">
    <div>
        <strong>$bannerText</strong>
        <div id="$endId" class="LoginPassKeyBannerResult"></div>
    </div>
    <div class="LoginPassKeyBannerActions">
        <button type="button" id="LoginPassKeyRegisterButton" class="ui-button ui-widget ui-corner-all">$addText</button>
        <button type="button" id="LoginPassKeyDismissButton" class="ui-button ui-widget ui-corner-all">$dismissText</button>
    </div>
</div>
<script>
(() => {
    const banner = document.getElementById('$bannerId');
    const result = document.getElementById('$endId');
    const add = document.getElementById('LoginPassKeyRegisterButton');
    const dismiss = document.getElementById('LoginPassKeyDismissButton');
    const apiUrl = '$apiUrl';
    const fwd = $fwdJSON;

    if(dismiss && banner) {
        dismiss.addEventListener('click', () => banner.remove());
    }
    if(add && banner) {
        add.addEventListener('click', (event) => {
            event.preventDefault();
            lpk.action(apiUrl + 'register', fwd).then((res) => {
                if(res && res.msg && result) result.textContent = res.msg;
                if(res && (res.errno === 102 || res.errno === 101)) {
                    if(result) result.textContent = res.msg || '$successText';
                    add.disabled = true;
                    banner.classList.add('is-success');
                    window.setTimeout(() => banner.classList.add('is-fading'), 1400);
                    window.setTimeout(() => banner.remove(), 1800);
                }
            });
        });
    }
})();
</script>
HTML;
            $return = $this->injectPasskeyBanner($event->return, $html);

            $event->return = $return;
        }
    }

    protected function injectPasskeyBanner(string $markup, string $banner): string
    {
        $targets = [
            '<div id="content"',
            '<main',
            '<body',
        ];

        foreach ($targets as $target) {
            $pos = stripos($markup, $target);
            if ($pos === false) continue;

            $close = strpos($markup, '>', $pos);
            if ($close === false) continue;

            return substr($markup, 0, $close + 1) . $banner . substr($markup, $close + 1);
        }

        return str_ireplace("</body>", $banner . "</body>", $markup);
    }

    public function processProfilePasskeyActions(HookEvent $event): void
    {
        $input = $this->wire('input');
        if (!$input->post('lpk_profile_delete')) return;

        $user = $this->wire('user');
        $session = $this->wire('session');

        if (!$this->canSelfManagePasskeys($user)) {
            throw new WirePermissionException($this->_('You do not have permission to manage passkeys.'));
        }

        if (!$session->CSRF->hasValidToken()) {
            throw new WireException($this->_('Invalid form submission.'));
        }

        $ids = \array_values(\array_filter(\array_map('intval', (array) $input->post('lpk_profile_deletes'))));
        if (\count($ids) > 0) {
            $count = $this->deleteUserPasskeys($user, $ids);
            if ($count > 0) {
                $this->message(sprintf(_n('%d PassKey deleted from database.', '%d PassKeys deleted from database.', $count), $count));
            }
        }

        $session->redirect('./');
    }

    public function addProfilePasskeyManagement(HookEvent $event): void
    {
        $markup = $event->return;
        if (!\is_string($markup) || $markup === '') return;

        $user = $this->wire('user');
        if (!$this->canSelfManagePasskeys($user)) return;

        $profileMarkup = $this->renderProfilePasskeyManagement($user);
        if ($profileMarkup === '') return;

        if (\strpos($markup, $this->className() . ".js") === false) {
            $profileMarkup = "<script src='" . $this->config()->urls($this) . $this->className() . ".js'></script>" . $profileMarkup;
        }
        $event->return = str_ireplace('</form>', $profileMarkup . '</form>', $markup);
    }

    protected function renderProfilePasskeyManagement(User $user, string $deleteSubmitName = 'lpk_profile_delete', string $deleteSubmitValue = '1'): string
    {
        $sanitizer = $this->wire('sanitizer');
        $rows = $this->getUserPasskeyRows($user);

        $out = "<fieldset class='Inputfield LoginPassKeyProfilePasskeys'>";
        $out .= "<legend class='InputfieldHeader'>" . $this->_('Passkeys') . "</legend>";
        $out .= "<div class='InputfieldContent'>";
        $out .= "<p>" . $this->_('Deleting passkeys from your profile removes them from this site but not from your device or passkey manager.') . "</p>";

        if (\count($rows) === 0) {
            $out .= "<p>" . $this->_('You do not have any passkeys registered for this site.') . "</p>";
        } else {
            $out .= "<table class='AdminDataTable AdminDataList LoginPassKeyProfileTable'>";
            $out .= "<thead><tr>";
            $out .= "<th>" . $this->_('Id') . "</th>";
            $out .= "<th>" . $this->_('Created') . "</th>";
            $out .= "<th>" . wireIconMarkup('trash', 'lg') . "</th>";
            $out .= "</tr></thead><tbody>";

            foreach ($rows as $row) {
                $id = (int) $row['id'];
                $created = $sanitizer->entities((string) $row['created']);
                $out .= "<tr>";
                $out .= "<td>$id</td>";
                $out .= "<td>$created</td>";
                $out .= "<td><label><input type='checkbox' name='lpk_profile_deletes[]' value='$id'> " . $this->_('Delete') . "</label></td>";
                $out .= "</tr>";
            }

            $out .= "</tbody></table>";
            $deleteSubmitName = $sanitizer->fieldName($deleteSubmitName);
            $deleteSubmitValue = $sanitizer->entities($deleteSubmitValue);
            $out .= "<button type='submit' name='$deleteSubmitName' value='$deleteSubmitValue' class='ui-button ui-widget ui-corner-all'>";
            $out .= wireIconMarkup('trash') . " " . $this->_('Delete checked passkeys');
            $out .= "</button>";
        }

        $apiUrl = $this->api_url;
        $fwd = new \stdClass();
        $fwd->fn = 'finduser';
        $fwd->un = $user->name;
        $fwd->next = 'register';

        $data = new \stdClass();
        $data->pk = $this->preRegisterUser($user);
        $data->csrf = $this->getRegisterCsrfToken();
        $data->next = 'register';
        $fwd->data = $data;

        $fwdJSON = \json_encode($fwd);
        $addText = $this->_('Add passkey');
        $successText = $this->_('Passkey added. Reloading profile.');

        $out .= "<p class='LoginPassKeyProfileActions'>";
        $out .= "<button type='button' id='LoginPassKeyProfileAdd' class='ui-button ui-widget ui-corner-all'>";
        $out .= wireIconMarkup('key') . " " . $addText;
        $out .= "</button>";
        $out .= " <span id='LoginPassKeyProfileResult' class='LoginPassKeyBannerResult'></span>";
        $out .= "</p>";
        $out .= <<<HTML
<script>
(() => {
    const add = document.getElementById('LoginPassKeyProfileAdd');
    const result = document.getElementById('LoginPassKeyProfileResult');
    const fwd = $fwdJSON;

    if(!add) return;
    add.addEventListener('click', (event) => {
        event.preventDefault();
        lpk.action('$apiUrl' + 'register', fwd).then((res) => {
            if(res && res.msg && result) result.textContent = res.msg;
            if(res && (res.errno === 102 || res.errno === 101)) {
                if(result) result.textContent = res.msg || '$successText';
                add.disabled = true;
                window.setTimeout(() => window.location.reload(), 1200);
            }
        });
    });
})();
</script>
HTML;

        $out .= "</div></fieldset>";
        return $out;
    }

    public function renderSelfManagePasskeys(User $user, string $deleteSubmitName = 'lpk_profile_delete', string $deleteSubmitValue = '1'): string
    {
        if (!$this->canSelfManagePasskeys($user)) return '';
        return $this->renderProfilePasskeyManagement($user, $deleteSubmitName, $deleteSubmitValue);
    }

    public function getApiHttpUrl()
    {
        return 'https://' . $this->rp  .  $this->api_url;
    }

    public function getRedirectUrl()
    {
        $sanitizer = $this->wire('sanitizer');
        $pages = $this->wire('pages');
        $pathOrId = \strpos($this->redirect_url,'/') !== false ? $sanitizer->text($this->redirect_url) : $sanitizer->int($this->redirect_url);

        return $pages->get($pathOrId)->url;
    }

    public function handleApiStep($data, string $step): \stdClass
    {
        if (!$this->apiRequestIsPost()) {
            if (!\headers_sent()) {
                \header('Allow: POST', true, 405);
            }
            return $this->apiError($this->_('Method not allowed'), 405);
        }

        if (!$data instanceof \stdClass) {
            $data = new \stdClass();
        }

        $session = $this->wire('session');
        $modules = $this->wire('modules');
        $pages = $this->wire('pages');
        $user = $this->wire('user');

        $lpkData = new \stdClass();
        $lpkData->data = $data;

        switch ($step) {
            case 'finduser':
                $username = $data->un ?? '';
                $foundUser = $this->findUser($username);
                $session->setFor('lpk', 'username', $username);

                if (empty($foundUser->msg)) {
                    $feUserObj = $this->getUserByField($foundUser->un);

                    if ($feUserObj instanceof User) {
                        $session->setFor('lpk', 'userid', $feUserObj->id);
                        $nextAction = $foundUser->next ?? 'end';

                        if ($nextAction === 'verify') {
                            $lpkData->data->verifyArgs = $this->verifyUser($feUserObj);
                            $lpkData->data->next = 'verify';
                        } elseif ($nextAction === 'register' && $user->isLoggedIn() && $user->id === $feUserObj->id) {
                            $lpkData->data->pk = $this->preRegisterUser($feUserObj);
                            $lpkData->data->csrf = $this->getRegisterCsrfToken();
                            $lpkData->data->feUserid = $feUserObj->id;
                            $lpkData->data->next = 'register';
                        } elseif ($nextAction === 'register') {
                            $lpkData->data->msg = $this->getErrorMessage(50);
                            $lpkData->data->errno = 50;
                            $lpkData->data->next = 'end';
                        } else {
                            $lpkData->data->next = 'end';
                        }
                    }
                } else {
                    $lpkData->data->msg = $foundUser->msg;
                    $lpkData->data->next = 'end';
                }
                break;

            case 'register':
                $lpkData->data = new \stdClass();

                if (!empty($data->aarcreate)) {
                    if (!$this->registerCsrfValid($data)) {
                        $lpkData = $this->apiError($this->_('Invalid session'), 403);
                        break;
                    }

                    $created = $this->registerUser($user, $data->aarcreate);

                    if (!!$created) {
                        $session->setFor('lpk', 'success', 'success');
                        $session->removeFor('lpk', 'username');
                        $lpkData = $created;
                    }
                } else {
                    $lpkData->msg = $this->getErrorMessage(2);
                    $lpkData->errno = 2;
                }
                break;

            case 'verify':
                $errno = $data->errno ?? 4;
                if (($errno && $errno !== 101) || empty($data->aarverify)) {
                    $lpkData->msg = $this->getErrorMessage($errno);
                    $lpkData->errno = $errno;
                    $lpkData->data->next = 'end';
                } else {
                    $verified = $this->verifyResponse($data->aarverify, $data->challenge ?? null, $data->signedData ?? null);

                    $lpkData->data = $verified;
                    if ($verified->errno === 101) {
                        $lpkData->msg = $this->getErrorMessage(101);
                        $username = $session->getFor('lpk', 'username');
                        $feUser = $this->getUserByField($username);
                        $session->setFor('lpk', 'success', 'success');
                        $session->forceLogin($feUser);

                        $this->finishVerifiedLogin($lpkData);
                    }
                }
                break;

            case 'discover-start':
                if ((int) $this->enabledDiscover !== 1) {
                    $lpkData->data->msg = $this->getErrorMessage(61);
                    $lpkData->data->errno = 61;
                    $lpkData->data->next = 'end';
                } else {
                    $lpkData->data->verifyArgs = $this->discoverUser();
                    $lpkData->data->next = 'discover-verify';
                }
                break;

            case 'discover-verify':
                $errno = $data->errno ?? 4;
                if (($errno && $errno !== 101) || empty($data->aarverify)) {
                    $lpkData->msg = $this->getErrorMessage($errno);
                    $lpkData->errno = $errno;
                    $lpkData->data->next = 'end';
                } else {
                    $verified = $this->verifyDiscoverResponse($data->aarverify, $data->signedData ?? null);

                    $lpkData->data = $verified;
                    if ($verified->errno === 101) {
                        $lpkData->msg = $this->getErrorMessage(101);
                        $session->setFor('lpk', 'success', 'success');
                        $session->forceLogin($verified->user);
                        unset($lpkData->data->user);
                        $this->finishVerifiedLogin($lpkData);
                    }
                }
                break;

            case 'end':
            case 'start':
            default:
                break;
        }

        return $lpkData;
    }

    protected function apiRequestIsPost(): bool
    {
        return $this->wire('input')->requestMethod('POST');
    }

    protected function apiError(string $message, int $errno): \stdClass
    {
        $output = new \stdClass();
        $output->end = true;
        $output->msg = $message;
        $output->errno = $errno;
        $output->next = 'end';
        return $output;
    }

    protected function finishVerifiedLogin(\stdClass $lpkData): void
    {
        $session = $this->wire('session');
        $modules = $this->wire('modules');
        $pages = $this->wire('pages');
        $lpkConfig = $modules->getConfig('LoginPassKey');

        if ($session->getFor('lpk', 'inadmin')) {
            $processLogin = $modules->get('ProcessLogin');
            $processLogin->execute();
        } elseif ($modules->isInstalled('LoginRegisterPro') && $lpkConfig['enabled'] === 1) {
            $processLogin = $modules->get('LoginRegisterPro');
            $processLogin->execute();
        } elseif (!empty($lpkConfig['redirect_url'])) {
            $lpkData->goto = $this->getRedirectUrl();
            if (isset($lpkData->data) && $lpkData->data instanceof \stdClass) {
                $lpkData->data->goto = $lpkData->goto;
            }
        } else {
            $lpkData->goto = $pages->get(1)->httpUrl;
            if (isset($lpkData->data) && $lpkData->data instanceof \stdClass) {
                $lpkData->data->goto = $lpkData->goto;
            }
        }
    }

    public function getDatabase()
    {
        return wire('database');
    }

    public function getTableName() : string
    {
       // return wire('sanitizer')->pageName($this->className());
        return $this->className(['lowercase']);
    }

    public function showUser()
    {
        return $this->user;
    }

    public function findUser(mixed $username = null)
    {
        /*
         * Scenarios
         * 1. Username field empty xx
         * 2. User is not logged in but device does support WebAuthn
         * 3. User is not logged in, device supports WebAuthn but username not found xx
         * 4. User is logged in but device does not support WebAuthn
         * 5. User is logged, device does support WebAuthn but user does not WebAuthn challenge set
         * 6. User roles do not match supported roles
         * 7. User roles match supported roles, user is not logged in and has WebAuthn challenge set
         * 8. User is loggedin and username does not match username input
         * 9. User logged in with PassKey
         */
        $output = new \stdClass();

        // Scenario 1
        if(empty($username)) {
            $output->fn = 'findUser';
            $output->msg = $this->getErrorMessage(60);
            $output->errno = 60;
            $output->next = 'end';
            return $output;
        }

        $users = wire('users');
        $user = wire('user');
        $feUser = $this->getUserByField($username);

        // Scenario 3
        if($feUser instanceof NullPage) {
        //    $output->id = $feUser->id;

            $output->msg = $this->getErrorMessage(65) . $username;
            $output->errno = 65;
            $output->fn = 'findUser';
            $output->next = 'end';
            return $output;
        }

        // Now to see if the FE User is allowed to use WebAuthn
        $allowed = $this->userAllowed($feUser);

        if(!$allowed) {
            $output->msg = $this->getErrorMessage(70);
            $output->errno = 70;
            $output->next = 'end';
            return $output;
        }

        // Superuser must be checked to allow Superusers to use WebAuthn
        // Superusers by default have all permissions
        if($feUser->isSuperuser() && !empty($this->roles[0]) )
            $allowed = true;

        if (!$allowed) {
            $output->un = $username;
            $output->msg = $this->getErrorMessage(80);
            $output->errno = 80;
            $output->fn = 'finduser';
            $output->next = 'end';
            return $output;
        }

        // Checked loggedin user is trying to log in as someone else
        if($feUser instanceof User && $user->isLoggedin() && $user->id !== $feUser->id) {
            $output->un = $username;
            $output->msg = $this->getErrorMessage(90);
            $output->errno = 90;
            $output->fn = 'finduser';
            $output->next = 'end';
            return $output;
        }

        // Scenario 9
        $loggedInWithPassKey = $this->wire('session')->getFor('lpk', 'success');
        if(!$user->isGuest()) {
            // User used a passkey to login
            $output->fn = 'findUser';
            if(!!$loggedInWithPassKey) {
                $output->msg = $this->getErrorMessage(66);
                $output->errno = 66;
                $output->next = 'end';
            } else {
//                $output->msg = $this->getErrorMessage(67);
                $output->errno = 67;
                $output->next = 'register';
            }
            //   $output->msg = !!($loggedInWithPassKey) ? $this->getErrorMessage(66) : $this->getErrorMessage(67);
            $output->un = $username;
            return $output;
        }

        // The user is legit and permitted to use WebAuthn
        if($user->isGuest() ) {
            $count = $this->_checklpkDB($feUser);
            // if count 0, they need to login with their password to register
            // otherwise, they have credentials in the DB which need to be verified

            $action = $count > 0 ? "verify" : "register";
            $output->un = $username;
            if($count > 0 ) {
                $output->verifyArgs = $this->prepareToValidate($feUser);
            }
            $output->fn = 'finduser';
            $output->next = $action;
            return $output;
        }

        // Action to take for loggedin user if in/out of lpkDB
        $output->un = $username;
        $output->fn = 'finduser';
        $output->next = "register";
        return $output;
    }

    public function getUserByField($username)
    {
        if(!$username instanceof User) {
            // it's the text-based name or email
            $sanitizer = $this->wire('sanitizer');

            $fld = $this->user_fld;
            $username = $sanitizer->text($username);
            $user = $this->wire('users')->get("name|$fld=$username");
        }
        return $user;
    }

    private function _checklpkDB($user)
    {
        // OK they're a valid user
        // Now let's see if they have existing credentials
        try {
            $db = wire('database');
            $sql = "SELECT COUNT(user_id) FROM " . $this->getTableName() . " WHERE user_id=:user_id";
            $query = $db->prepare($sql);
            $query->bindValue(':user_id', (int) $user->id, \PDO::PARAM_INT);
            $query->closeCursor();
            $query->execute();
            return (int) $query->fetchColumn();
        } catch (WireException $e) {
            $this->wire('log')->save($this->className(), "Database Exception: " . $e->getMessage());
            return 0;
        }
    }

    public function userHasPasskey(User $user): bool
    {
        return $this->_checklpkDB($user) > 0;
    }

    public function canSelfManagePasskeys(?User $user = null): bool
    {
        if ((int) $this->enabled !== 1 && (int) $this->enabledAdmin !== 1) return false;
        $user = $user ?: $this->wire('user');
        if (!$user instanceof User || $user->isGuest()) return false;
        return $user->hasPermission('profile-edit');
    }

    public function getUserPasskeyRows(User $user): array
    {
        try {
            $db = $this->wire('database');
            $sql = "SELECT `id`, `created` FROM " . $this->getTableName() . " WHERE user_id=:user_id ORDER BY created DESC, id DESC";
            $query = $db->prepare($sql);
            $query->bindValue(':user_id', (int) $user->id, \PDO::PARAM_INT);
            $query->closeCursor();
            $query->execute();
            return $query->fetchAll(\PDO::FETCH_ASSOC);
        } catch (WireException $e) {
            $this->wire('log')->save($this->className(), "Database Exception: " . $e->getMessage());
            return [];
        }
    }

    public function deleteUserPasskeys(User $user, array $ids): int
    {
        $ids = \array_values(\array_filter(\array_map('intval', $ids)));
        if (\count($ids) === 0) return 0;

        $placeholders = \implode(',', \array_fill(0, \count($ids), '?'));
        $sql = "DELETE FROM " . $this->getTableName() . " WHERE user_id=? AND id IN ($placeholders)";
        $params = \array_merge([(int) $user->id], $ids);

        try {
            $db = $this->wire('database');
            $query = $db->prepare($sql);
            $query->closeCursor();
            $query->execute($params);
            return $query->rowCount();
        } catch (WireException $e) {
            $this->wire('log')->save($this->className(), "Database Exception: " . $e->getMessage());
            return 0;
        }
    }

    private function _getCredentialsFromDB(User $user)
    {
        try {
            $db = wire('database');
            $sql = "SELECT `id`, `credential_id`, `public_key`, `sign_count` from " . $this->getTableName() . " where user_id=" . $user->id;
            $query = $db->prepare($sql);
            $query->closeCursor();
            $query->execute();
            $result = $query->fetchAll(\PDO::FETCH_ASSOC);
            return $result;
        } catch (\Throwable $e) {
            $this->wire('log')->save($this->className(), "Database Exception: " . $e->getMessage());
            return [];
        }
    }

    private function _getCredentialByCredentialId(string $credentialId)
    {
        try {
            $db = wire('database');
            $sql = "SELECT `id`, `user_id`, `credential_id`, `public_key`, `sign_count` FROM " . $this->getTableName() . " WHERE credential_id=:credential_id LIMIT 1";
            $query = $db->prepare($sql);
            $query->bindValue(":credential_id", $credentialId);
            $query->closeCursor();
            $query->execute();
            $result = $query->fetch(\PDO::FETCH_ASSOC);
            return $result ?: null;
        } catch (\Throwable $e) {
            $this->wire('log')->save($this->className(), "Database Exception: " . $e->getMessage());
            return null;
        }
    }

    public function prepareToValidate($user)
    {
        $existingCredentials = $this->_getCredentialsFromDB($user);
        $lpkArgs = $this->getlpkargs();

        $args = new \stdClass();
        $args->publicKey = new \stdClass();
        $args->publicKey->timeout = 600000; // microseconds
        $args->publicKey->challenge = $this->_createChallenge();  // binary
        $args->publicKey->userVerification = $this->userVerification;
        $args->publicKey->rpId = $lpkArgs->rp;

        if (\is_array($existingCredentials) && \count($existingCredentials) > 0) {
            $args->publicKey->allowCredentials = [];

            foreach ($existingCredentials as $id) {
                $tmp = new \stdClass();
                $tmp->id = $id;
                $tmp->transports = $this->transports;
                $tmp->type = 'public-key';
                $args->publicKey->allowCredentials[] = $tmp;
                unset ($tmp);
             }
        }
        return $args;
    }


    private function _saveCredentialToDB($created)
    {
        // User has to be logged in to get to this point
        $user = $this->wire('user');
        $db = $this->wire('database');
        $userID = $user->id;
        $credentialID =$created->credentialId;

        $sql = <<<SQL
            INSERT INTO {$this->getTableName()}
            (
             user_id, 
             credential_id,
             public_key,
             sign_count
             ) 
            VALUES 
            ( 
             :user_id,
             :credential_id,
             :public_key,
             :sign_count
            )
        SQL;

        $pem = strpos($created->publicKey, 'BEGIN PUBLIC KEY') !== false
            ? $created->publicKey
            : $this->publicKeyToPem($created->publicKey);
        $signCount = (int) ($created->signCount ?? 0);
        $query = $db->prepare($sql);
        $query->bindParam(":user_id", $userID);
        $query->bindParam(":credential_id", $credentialID);
        $query->bindParam(":public_key", $pem);
        $query->bindParam(":sign_count", $signCount, \PDO::PARAM_INT);
        $query->closeCursor();
        return $query->execute() ? true : false;
    }

    public function preRegisterUser($user)
    {
        // valid, loggedin user and can use Passkeys. Need to register for this app

        $lpkArgs = $this->getlpkargs();
        $lpkArgs->crossPlatformAttachment = $this->crossPlatformAttachment;
        $excludeRegistrations = $this->_getCredentialsFromDB($user);

        $args = new \stdClass();
        $args->publicKey = new \stdClass();

        // relying party
        $args->publicKey->rp = new \stdClass();
        $args->publicKey->rp->name = $lpkArgs->appname;
        $args->publicKey->rp->id = $lpkArgs->rp;

        $args->publicKey->authenticatorSelection = new \stdClass();
        $args->publicKey->authenticatorSelection->userVerification = $this->userVerification;

        $requireDiscoverable = (int) $this->enabledDiscover === 1;
        $args->publicKey->authenticatorSelection->residentKey = $requireDiscoverable ? 'required' : $this->residentKey;
        $args->publicKey->authenticatorSelection->requireResidentKey = $requireDiscoverable;

        $crossPlatformAttachment = in_array($this->crossPlatformAttachment, ['platform', 'cross-platform'])
            ? $this->crossPlatformAttachment
            : 'platform';

        $args->publicKey->authenticatorSelection->authenticatorAttachment = $crossPlatformAttachment;

        // user
        $args->publicKey->user = new \stdClass();
        $args->publicKey->user->id = $user->id; // binary

        // Get the username or email address based on the User object
        $fld = $this->user_fld;
        $username = $user->$fld;

        $args->publicKey->user->name = $username;
        $args->publicKey->user->displayName = '';

        // supported algorithms
        $args->publicKey->pubKeyCredParams = [];

        $tmp = new \stdClass();
        $tmp->type = 'public-key';
        $tmp->alg = -8; // EdDSA
        $args->publicKey->pubKeyCredParams[] = $tmp;
        unset ($tmp);

        $tmp = new \stdClass();
        $tmp->type = 'public-key';
        $tmp->alg = -7; // ES256
        $args->publicKey->pubKeyCredParams[] = $tmp;
        unset ($tmp);

        $tmp = new \stdClass();
        $tmp->type = 'public-key';
        $tmp->alg = -257; // RS256
        $args->publicKey->pubKeyCredParams[] = $tmp;
        unset ($tmp);

        // attestation
        $args->publicKey->attestation = $this->attestationFormat;

        $args->publicKey->extensions = new \stdClass();
        $args->publicKey->extensions->exts = true;
        $args->publicKey->timeout = 600000; // microseconds
        $args->publicKey->challenge = $this->_createChallenge(); // binary
        $this->rememberRegistrationChallenge($user, $args->publicKey->challenge);

        // save challenge to the session in case we need it later
        //prevent re-registration by specifying existing credentials
        $args->publicKey->excludeCredentials = [];

        if (is_array($excludeRegistrations) && \count($excludeRegistrations) > 0) {
            foreach ($excludeRegistrations as $id) {
                $tmp = new \stdClass();
                $tmp->id = $id['credential_id'];
                $tmp->type = 'public-key';
                $tmp->transports = $this->transports;
                $args->publicKey->excludeCredentials[] = $tmp;
                unset ($tmp);
            }
        }
    return $args;
    }

    public function registerUser($user, $credData = null)
    {
        $output = new \stdClass();
        // finish up after regardless of outcome
        $output->next = 'end';
        $output->msg = $this->getErrorMessage(2);
        $output->errno = 2;


        if(is_null($credData)) {
            $output->errno = 3;
            $output->msg = $this->getErrorMessage(3);
            return $output;
        }

        $expectedChallenge = $this->consumeRegistrationChallenge($user, $credData);
        if (empty($expectedChallenge)) {
            return $output;
        }

        $toDB = $this->verifyRegistrationAttestation($user, $credData, $expectedChallenge);
        if (!$toDB) {
            return $output;
        }

        try {
            $output->created = $this->_saveCredentialToDB($toDB);
            if($output->created !== false) {
                $output->msg = $this->getErrorMessage(102);
                $output->errno = 102;
            }
        } catch(WireException $e) {
            $this->wire('log')->save($this->className(), "Database Exception: " . $e->getMessage());
            $output->created = 0;
            $output->msg = $this->getErrorMessage(2);
            $output->errno = 2;
        }
        return $output;
    }

    protected function verifyRegistrationAttestation(User $user, $credData, string $expectedChallenge): ?\stdClass
    {
        if (!$this->loadWebAuthnLibrary()) {
            $this->wire('log')->save($this->className(), 'Registration verification failed: lbuchs/webauthn is not installed');
            return null;
        }

        if (empty($credData->id) || empty($credData->response->clientDataJSON) || empty($credData->response->attestationObject)) {
            return null;
        }

        $clientDataJSON = $this->base64url_decode($credData->response->clientDataJSON);
        $attestationObject = $this->base64url_decode($credData->response->attestationObject);
        if ($clientDataJSON === false || $attestationObject === false) {
            return null;
        }

        $lpkArgs = $this->getlpkargs();

        try {
            $clientData = \json_decode($clientDataJSON);
            if (!$clientData || !$this->clientDataOriginAllowed($clientData, $lpkArgs->rp)) {
                return null;
            }

            $webauthn = new \lbuchs\WebAuthn\WebAuthn(
                $lpkArgs->appname,
                $lpkArgs->rp,
                ['none', 'packed', 'apple'],
                true
            );

            $verified = $webauthn->processCreate(
                $clientDataJSON,
                $attestationObject,
                $expectedChallenge,
                $this->userVerification === 'required',
                true,
                true
            );
        } catch (\Throwable $e) {
            $this->wire('log')->save($this->className(), 'Registration verification failed: ' . $e->getMessage());
            return null;
        }

        $credentialId = $this->base64url_encode($verified->credentialId);
        if (!hash_equals($credentialId, (string) $credData->id)) {
            $this->wire('log')->save($this->className(), 'Registration verification failed: credential ID mismatch');
            return null;
        }

        $toDB = new \stdClass();
        $toDB->user_id = $user->id;
        $toDB->credentialId = $credentialId;
        $toDB->publicKey = $verified->credentialPublicKey;
        $toDB->signCount = (int) ($verified->signatureCounter ?? 0);
        return $toDB;
    }

    protected function rememberRegistrationChallenge(User $user, string $challenge): void
    {
        $session = $this->wire('session');
        $pending = $session->getFor('lpk', 'registerChallenges');
        $pending = \is_array($pending) ? $pending : [];
        $now = \time();

        foreach ($pending as $hash => $entry) {
            if (!\is_array($entry) || ($entry['created'] ?? 0) < $now - 600) {
                unset($pending[$hash]);
            }
        }

        $pending[\hash('sha256', $challenge)] = [
            'challenge' => $challenge,
            'user_id' => (int) $user->id,
            'created' => $now,
        ];

        if (\count($pending) > 10) {
            $pending = \array_slice($pending, -10, null, true);
        }

        $session->setFor('lpk', 'registerChallenges', $pending);
        $session->removeFor('lpk', 'registerChallenge');
    }

    protected function consumeRegistrationChallenge(User $user, $credData): ?string
    {
        if (empty($credData->response->clientDataJSON)) {
            return null;
        }

        $clientDataJSON = $this->base64url_decode($credData->response->clientDataJSON);
        if ($clientDataJSON === false) {
            return null;
        }

        $clientData = \json_decode($clientDataJSON);
        if (!$clientData || empty($clientData->challenge) || !\is_string($clientData->challenge)) {
            return null;
        }

        $clientChallenge = $this->base64url_decode($clientData->challenge);
        if ($clientChallenge === false) {
            return null;
        }

        $session = $this->wire('session');
        $pending = $session->getFor('lpk', 'registerChallenges');
        $pending = \is_array($pending) ? $pending : [];
        $hash = \hash('sha256', $clientChallenge);
        $entry = $pending[$hash] ?? null;

        if (!\is_array($entry) || (int) ($entry['user_id'] ?? 0) !== (int) $user->id || empty($entry['challenge'])) {
            $this->wire('log')->save($this->className(), sprintf(
                'Registration challenge not pending: user_id=%d pending_count=%d',
                (int) $user->id,
                \count($pending)
            ));
            return null;
        }

        unset($pending[$hash]);
        $session->setFor('lpk', 'registerChallenges', $pending);
        return $entry['challenge'];
    }

    public function getRegisterCsrfToken(): string
    {
        return $this->wire('session')->CSRF->getTokenValue(self::REGISTER_CSRF_ID);
    }

    protected function registerCsrfValid($data): bool
    {
        if (!$this->wire('config')->protectCSRF) {
            return true;
        }

        $submitted = isset($data->csrf) && \is_string($data->csrf) ? $data->csrf : '';
        if ($submitted === '') {
            return false;
        }

        $expected = $this->getRegisterCsrfToken();
        return $expected !== '' && \hash_equals($expected, $submitted);
    }

    protected function loadWebAuthnLibrary(): bool
    {
        if (class_exists('\lbuchs\WebAuthn\WebAuthn')) {
            return true;
        }

        $autoload = __DIR__ . '/vendor/autoload.php';
        if (is_file($autoload)) {
            require_once $autoload;
        }

        return class_exists('\lbuchs\WebAuthn\WebAuthn');
    }

    public function verifyUser($user) {

        $allowCredentials = [];
        $existingCredentials = $this->_getCredentialsFromDB($user);
        if(\count($existingCredentials) > 0) {
            foreach($existingCredentials as $credential) {
                $obj = new \stdClass();
                $obj->id = $credential['credential_id'];
                $obj->type = "public-key";
                $allowCredentials[] = $obj;
            }
        }

        $lpkArgs = $this->getlpkargs();

        $output = new \stdClass();
        $output->publicKey = new \stdClass();
        $output->publicKey->timeout = 420000000; // microseconds = 7mins
        $output->publicKey->challenge = $this->_createChallenge();  // binary
        $this->wire('session')->setFor('lpk', 'verifyChallenge', $this->base64url_encode($output->publicKey->challenge));
        $output->publicKey->userVerification = $this->userVerification;
        $output->publicKey->rpId = $lpkArgs->rp;
        $output->publicKey->authenticatorSelection = new \stdClass();
        if(!empty($allowCredentials))
            $output->publicKey->allowCredentials = $allowCredentials;
        return $output;
    }

    public function discoverUser()
    {
        $lpkArgs = $this->getlpkargs();

        $output = new \stdClass();
        $output->publicKey = new \stdClass();
        $output->publicKey->timeout = 420000000; // microseconds = 7mins
        $output->publicKey->challenge = $this->_createChallenge();
        $this->wire('session')->setFor('lpk', 'verifyChallenge', $this->base64url_encode($output->publicKey->challenge));
        $output->publicKey->userVerification = $this->userVerification;
        $output->publicKey->rpId = $lpkArgs->rp;
        return $output;
    }

//    public function verifyResponse($authenticatorAttestationResponse = null, $challenge = null)
    public function verifyResponse($credData = null, $challenge = null, $signedData = null)
    {
        $output = new \stdClass();
        $output->fn = 'verify';
        $output->msg = $this->getErrorMessage(4);
        $output->errno = 4;
        $output->next = 'end';

        $sanitizer = $this->wire('sanitizer');
        $session = $this->wire('session');

        $userid = $sanitizer->int($session->getFor('lpk', 'userid'));
        $feUser = $this->wire('users')->get($userid);

        // user passkey saved in DB
        $userPassKeys = $this->_getCredentialsFromDB($feUser);
        // no saved passkeys
        if(\count($userPassKeys) < 1)
            return $output;

        $userPassKey = '';
        foreach($userPassKeys as $passKey) {
            if($passKey['credential_id'] === $credData->id) {
                $userPassKey = $passKey;
                break;
            }
        }

        // didn't find a matching passkey
        if(empty($userPassKey)) {
            $output->msg = $this->_('Failed to verify passkey');
            return $output;
        }

        // got credentials data from the device
        if(!empty($credData)) {

            $getArgs = $this->getlpkargs();
            $clientDataJSON = $this->base64url_decode($credData->response->clientDataJSON);

            // no clientdatajson from the device
            $clientData = \json_decode($clientDataJSON);
            if(!$clientData) {
                $output->msg = $this->_('Failed to decode client data');
                return $output;
            }

            // relying party hosts don't match
            if(!$this->clientDataOriginAllowed($clientData, $getArgs->rp)) {
                $output->msg = $this->_('Failed to decode client data');
                return $output;
            }

            // challenges dont match
            $expectedChallenge = $session->getFor('lpk', 'verifyChallenge');
            $session->removeFor('lpk', 'verifyChallenge');
            if(empty($expectedChallenge) || $expectedChallenge !== $clientData->challenge) {
                $output->msg = $this->_('Challenge did not match');
                return $output;
            }

            if (!$this->authenticatorUserVerificationAllowed($credData)) {
                $output->msg = $this->_('User verification was not performed');
                return $output;
            }

            // credential id's don't match
            if($credData->id !== $userPassKey['credential_id']) {
                $output->msg = $this->_('Credential ID did not match');
                return $output;
            }

            // device failed to sign the request
            if(!$credData->response->signature) {
                $output->msg = $this->_('Signature not created');
                return $output;
            }

            if (strpos($userPassKey['public_key'], 'BEGIN PUBLIC KEY') === false) {
                $output->msg = $this->_('Public key not created');
                $publicKey = $this->publicKeyToPem($userPassKey['public_key']);
            } else {
                $publicKey = $userPassKey['public_key'];
            }

            $isValid = $this->verifyAssertionSignature($credData, $publicKey);
            if ($isValid !== 1) {
                return $output;
            }

            $newSignCount = $this->getAuthenticatorSignCount($credData);
            if (!$this->credentialCounterValid($userPassKey, $newSignCount)) {
                return $output;
            }

            // now check the user id's match
            $userHandle = $this->decodeUserHandleToInt($credData->response->userHandle ?? '');
            if ($userHandle < 1) {
                return $output;
            }

            if ($userid === $userHandle && $isValid === 1) {
                $this->updateCredentialSignCount($userPassKey, $newSignCount);
                $session->setFor('lpk', 'success', 'success');
                $output->msg = $this->getErrorMessage(101);
                $output->errno = 101;
            } else {
                $output->msg = $this->_('PassKey name does not match username');
                $output->errno = 99;
            }


        }
        return $output;
    }

    public function verifyDiscoverResponse($credData = null, $signedData = null)
    {
        $output = new \stdClass();
        $output->fn = 'discover-verify';
        $output->msg = $this->getErrorMessage(4);
        $output->errno = 4;
        $output->next = 'end';

        if (empty($credData) || empty($credData->id) || empty($credData->response)) {
            return $output;
        }

        $sanitizer = $this->wire('sanitizer');
        $session = $this->wire('session');
        $users = $this->wire('users');

        $userPassKey = $this->_getCredentialByCredentialId($credData->id);
        if (!\is_array($userPassKey)) {
            return $output;
        }

        $clientDataJSON = $this->base64url_decode($credData->response->clientDataJSON ?? '');
        $clientData = \json_decode($clientDataJSON);
        if (!$clientData) {
            return $output;
        }

        $getArgs = $this->getlpkargs();
        if (!$this->clientDataOriginAllowed($clientData, $getArgs->rp)) {
            return $output;
        }

        $expectedChallenge = $session->getFor('lpk', 'verifyChallenge');
        $session->removeFor('lpk', 'verifyChallenge');
        if (empty($expectedChallenge) || $expectedChallenge !== $clientData->challenge) {
            $output->msg = $this->_('Challenge did not match');
            return $output;
        }

        if (!$this->authenticatorUserVerificationAllowed($credData)) {
            return $output;
        }

        if ($credData->id !== $userPassKey['credential_id']) {
            return $output;
        }

        if (empty($credData->response->signature) || empty($credData->response->userHandle)) {
            return $output;
        }

        $userHandle = $this->decodeUserHandleToInt($credData->response->userHandle);
        $credentialUserId = $sanitizer->int($userPassKey['user_id']);
        if ($credentialUserId < 1 || $credentialUserId !== $userHandle) {
            return $output;
        }

        $feUser = $users->get($credentialUserId);
        if (!$feUser instanceof User || $feUser instanceof NullPage || $feUser->isGuest() || !$this->userAllowed($feUser)) {
            return $output;
        }

        $publicKey = $userPassKey['public_key'];
        if (strpos($publicKey, 'BEGIN PUBLIC KEY') === false) {
            $publicKey = $this->publicKeyToPem($publicKey);
        }

        $isValid = $this->verifyAssertionSignature($credData, $publicKey);
        if ($isValid === 1) {
            $newSignCount = $this->getAuthenticatorSignCount($credData);
            if (!$this->credentialCounterValid($userPassKey, $newSignCount)) {
                return $output;
            }

            $this->updateCredentialSignCount($userPassKey, $newSignCount);
            $output->msg = $this->getErrorMessage(101);
            $output->errno = 101;
            $output->user = $feUser;
        }

        return $output;
    }

    protected function verifyAssertionSignature($credData, string $publicKey): int
    {
        if (empty($credData->response->authenticatorData) || empty($credData->response->clientDataJSON) || empty($credData->response->signature)) {
            return 0;
        }

        $authenticatorData = $this->base64url_decode($credData->response->authenticatorData);
        $clientDataJSON = $this->base64url_decode($credData->response->clientDataJSON);
        $signature = $this->base64url_decode($credData->response->signature);
        if ($authenticatorData === false || $clientDataJSON === false || $signature === false) {
            return 0;
        }

        $signedData = $authenticatorData . hash('sha256', $clientDataJSON, true);
        $key = openssl_pkey_get_public($publicKey);
        if (!$key) {
            return 0;
        }

        return openssl_verify($signedData, $signature, $key, OPENSSL_ALGO_SHA256);
    }

    protected function authenticatorUserVerificationAllowed($credData): bool
    {
        if ($this->userVerification !== 'required') {
            return true;
        }

        if (empty($credData->response->authenticatorData)) {
            return false;
        }

        $authenticatorData = $this->base64url_decode($credData->response->authenticatorData);
        if ($authenticatorData === false || \strlen($authenticatorData) < 33) {
            return false;
        }

        $flags = \ord($authenticatorData[32]);
        return ($flags & 0x04) === 0x04;
    }

    protected function getAuthenticatorSignCount($credData): int
    {
        if (empty($credData->response->authenticatorData)) {
            return 0;
        }

        $authenticatorData = $this->base64url_decode($credData->response->authenticatorData);
        if ($authenticatorData === false || \strlen($authenticatorData) < 37) {
            return 0;
        }

        $unpacked = \unpack('Nsign_count', \substr($authenticatorData, 33, 4));
        return (int) ($unpacked['sign_count'] ?? 0);
    }

    protected function credentialCounterValid(array $credential, int $newSignCount): bool
    {
        $storedSignCount = (int) ($credential['sign_count'] ?? 0);
        if ($storedSignCount === 0 && $newSignCount === 0) {
            return true;
        }

        if ($newSignCount <= $storedSignCount) {
            $this->wire('log')->save($this->className(), sprintf(
                'Signature counter rollback rejected for credential id %d: stored=%d, received=%d',
                (int) ($credential['id'] ?? 0),
                $storedSignCount,
                $newSignCount
            ));
            return false;
        }

        return true;
    }

    protected function updateCredentialSignCount(array $credential, int $newSignCount): void
    {
        $credentialId = (string) ($credential['credential_id'] ?? '');
        if ($credentialId === '') return;

        $db = $this->wire('database');
        $sql = "UPDATE " . $this->getTableName() . " SET sign_count=:sign_count WHERE credential_id=:credential_id";
        $query = $db->prepare($sql);
        $query->bindValue(':sign_count', $newSignCount, \PDO::PARAM_INT);
        $query->bindValue(':credential_id', $credentialId);
        $query->closeCursor();
        $query->execute();
    }

    protected function decodeUserHandleToInt(string $userHandle): int
    {
        $decoded = $this->base64url_decode($userHandle);
        if ($decoded === false || $decoded === '') return 0;
        return ctype_digit($decoded) ? (int) $decoded : 0;
    }

    protected function clientDataOriginAllowed($clientData, string $rpId): bool
    {
        if (!isset($clientData->origin) || !is_string($clientData->origin)) return false;
        if (isset($clientData->crossOrigin) && $clientData->crossOrigin === true) return false;

        $origin = $clientData->origin;
        if (strpos($origin, '@') !== false || strpos($origin, '[') !== false) return false;

        $parts = parse_url($origin);
        if (!is_array($parts) || empty($parts['scheme']) || empty($parts['host'])) return false;

        $scheme = strtolower($parts['scheme']);
        $host = strtolower($parts['host']);
        $rpId = strtolower($rpId);

        if ($host !== '' && $host[strlen($host) - 1] === '.') {
            $host = substr($host, 0, -1);
        }

        if ($scheme !== 'https' && !($scheme === 'http' && ($host === 'localhost' || $host === '127.0.0.1'))) {
            return false;
        }

        if ($host === $rpId) return true;
        $suffix = '.' . $rpId;
        return strlen($host) > strlen($suffix) && substr($host, -strlen($suffix)) === $suffix;
    }

    public function getlpkargs()
    {
        $data = wire('modules')->getConfig($this);
        unset($data['enabled']);
        $data['attestation_format'] = $this->attestationFormat;
        $data['crossPlatformAttachment'] = $this->crossPlatformAttachment;
        $data['excludeRegistrations'] = [];

        $output = new \stdClass();
        foreach ($data as $key => $value) {
            $output->$key = $value;
        }
        return $output;
    }

    private function _createChallenge()
    {
        $bytes = random_bytes(32);
        return bin2hex($bytes);
    }


    #---------------------
    # Utility functions
    #---------------------

    public function getErrorMessage($mgsNumber = 99)
    {
        switch ($mgsNumber) {
            case 1:
                return $this->_('Sorry, your browser does not support this feature');
            case 2:
                return $this->_('Failed to create credentials');
            case 3:
                return $this->_("Failed to get authenticator attestation response");
            case 4:
                return $this->_('Failed to verify your passkey. Please use your password to log in.');
            case 5:
                return $this->_('Failed to get authenticator attestation response');
            case 8:
                return $this->_('Failed to verify');
            case 50:
                return $this->_('Please login with your password to register your passkey');
            case 60:
                return $this->_("No username provided");
            case 61:
                return $this->_("Passkey-only login is not enabled");
            case 65:
                return $this->_("No user with name: ");
            case 66:
                return $this->_("Already logged in with passkey");
            case 67:
                return $this->_("Already logged in with password");
            case 70:
                return $this->_("User does not have permission to use WebAuthn");
            case 80:
                return $this->_("User has disallowed role");
            case 90:
                return $this->_("Loggedin user does not match submitted User");
            case 99:
            default:
                return $this->_('Unknown error');
            case 101:
                return $this->_('Verified and logged in successfully');
            case 102:
                return $this->_('Successfully registered');
        }
    }


    public function base64url_decode($data)
    {
        $data = strtr($data, '-_', '+/');
        $padding = strlen($data) % 4;
        if ($padding > 0) {
            $data .= str_repeat('=', 4 - $padding);
        }
        return base64_decode($data);
    }

    public function base64url_encode($data)
    {
        return rtrim(strtr(base64_encode($data), '+/', '-_'), '=');
    }

    function publicKeyToPem($b64url) {
        // Step 1: Convert from base64url to base64
        $b64 = strtr($b64url, '-_', '+/');
        $b64 = rtrim($b64, '='); // remove extra padding if present

        // Step 2: Fix base64 padding (length must be divisible by 4)
        $mod4 = strlen($b64) % 4;
        if ($mod4 > 0) {
            $b64 .= str_repeat('=', 4 - $mod4);
        }

        // Step 3: Chunk the base64 into 64-character lines
        $pemBody = chunk_split($b64, 64, "\n");

        // Step 4: Wrap it in PEM headers
        return "-----BEGIN PUBLIC KEY-----\n" . $pemBody . "-----END PUBLIC KEY-----\n";
    }

    function userAllowed(User $user)
    {
        // Now to see if the FE User is allowed to use WebAuthn
        $allowed = false;
        foreach($user->roles as $role) {
            if (in_array($role->id, $this->roles))
                $allowed = true;
        }
        return $allowed;
    }
    #---------------------
    # Install and Uninstall
    #---------------------

    public function ___install()
    {
        $this->_createTable();

        $templates = $this->wire('templates');
        $files = $this->wire('files');
        $pages = $this->wire('pages');

        $lpkTemplate = $templates->get('name=lpk-api');
        if(!$lpkTemplate) {

            // Create fieldgroup
            $fieldgroup = new Fieldgroup();
            $fieldgroup->name = 'lpk-api';
            $fieldgroup->add('title');

            // save fieldgroup
            $this->wire('fieldgroups')->save($fieldgroup);

            // get fieldgroup
            $fieldgroup = wire('fieldgroups')->get('lpk-api');

            // Create template
            $template = new Template();
            $template->name = 'lpk-api';
            $template->label = 'LoginPassKey API Template';
            $template->fieldgroup = $fieldgroup;
            $template->filename = $this->config->paths->templates . 'lpk-api.php';
            $template->noChildren = 1;
            $template->noParents = -1; // one page only
            $template->urlSegments = 1;
            $template->contentType = "json";
            $template->https = 1; // always only https
            $template->noAppendTemplateFile = 1; // disable auto-append of eg _main.php
            $template->noUnpublish = 1; // must always be published

            // save template
            $templates->save($template);
        }

        $templateFileExists = $files->exists($this->config->paths->templates . 'lpk-api.php');
        if(!$templateFileExists) {
            $files->copy($this->config->paths($this) . 'lpk-api.php', $this->config->paths->templates . 'lpk-api.php');
        }

        $apiPage = $pages->get("name=lpk-api");
        if($apiPage instanceof NullPage) {
            $apiPage = new Page();
            $apiPage->name = 'lpk-api';
            $apiPage->parent = 1;
            $apiPage->template = 'lpk-api';
            $apiPage->of(false);
            $apiPage->title = $this->_('LoginPassKey API');
            $apiPage->status(['hidden', 'published']);
            $apiPage->save();
        }
    }

    public function ___upgrade($fromVersion, $toVersion)
    {
        $this->ensureApiTemplateUrlSegments();
        $this->ensureSignCountColumn();
    }

    protected function ensureApiTemplateUrlSegments(): void
    {
        $templates = $this->wire('templates');
        $template = $templates->get('name=lpk-api');
        if (!$template instanceof Template) return;

        if ((int) $template->urlSegments !== 1) {
            $template->urlSegments = 1;
            $templates->save($template);
        }
    }

    protected function ensureSignCountColumn(): void
    {
        $db = $this->wire('database');
        $table = $this->getTableName();
        $query = $db->prepare("SHOW COLUMNS FROM `$table` LIKE 'sign_count'");
        $query->closeCursor();
        $query->execute();

        if ($query->fetch(\PDO::FETCH_ASSOC)) {
            return;
        }

        $db->exec("ALTER TABLE `$table` ADD `sign_count` INT(10) UNSIGNED NOT NULL DEFAULT 0 AFTER `public_key`");
    }

    public function ___uninstall()
    {
        $pages = $this->wire('pages');
        $templates = $this->wire('templates');
        $files = $this->wire('files');

        $apiPage = $pages->get('name=lpk-api');
        if(!$apiPage instanceof NullPage) {
            $pages->delete($apiPage);
        }

        $apiTpl = $templates->get('name=lpk-api');
        if($apiTpl instanceof Template) {
            $templates->delete($apiTpl);
        }

        $tplFileExists = $files->exists($this->config->paths->templates . 'lpk-api.php');
        if($tplFileExists) {
            $files->unlink($this->config->paths->templates . 'lpk-api.php');
        }


        $this->_deleteTable();
    }

    protected function _createTable()
    {
        $sql =  "DROP TABLE IF EXISTS `" . $this->getTableName() ."`;" .
            "CREATE TABLE `" . $this->getTableName() . "`(".
            "id INT(10) NOT NULL AUTO_INCREMENT, " .
            "user_id INT(10) UNSIGNED NOT NULL, " .
            "credential_id TEXT NOT NULL, " .
            "public_key TEXT NOT NULL, " .
            "sign_count INT(10) UNSIGNED NOT NULL DEFAULT 0, " .
            "created TIMESTAMP NOT NULL default CURRENT_TIMESTAMP, " .
            "PRIMARY KEY (id), " .
            "INDEX user_id_index (user_id) " .
            ") CHARSET=utf8";

        $db = $this->getDatabase();
        return $db->exec($sql);
    }

    protected function _deleteTable()
    {
        $db = $this->getDatabase();
        $sql = "DROP TABLE IF EXISTS " . $this->getTableName();
        $db->exec($sql);
    }
}
